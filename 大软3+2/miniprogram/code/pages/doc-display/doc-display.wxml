<!-- pages/doc-display/doc-display.wxml -->
<view class="page">
  <view class="nav-bar">
    <view class="nav-back" bindtap="goBack" hover-class="nav-back-hover">
      <view class="nav-arrow"></view>
    </view>
    <text class="nav-title">{{title}}</text>
    <view class="nav-placeholder-right"></view>
  </view>

  <scroll-view class="content-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="content-body">
      <rich-text nodes="{{content}}"></rich-text>
    </view>
    <view class="content-footer">
      <text class="footer-text">感谢您使用司维者服务</text>
    </view>
  </scroll-view>
</view>
