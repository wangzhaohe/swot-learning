/* pages/doc-display/doc-display.wxss */

page {
  width: 100%;
  height: 100%;
  background: #F5F7FA;
  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', sans-serif;
}

.page {
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #F5F7FA;
}

/* ===== 导航栏 ===== */
.nav-bar {
  width: 100%;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 16px 0 0;
  background: #fff;
  border-bottom: 0.5px solid #E8ECF0;
  flex-shrink: 0;
  box-sizing: content-box;
}

.nav-back {
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.nav-back-hover {
  background: #F5F5F5;
}

.nav-arrow {
  width: 10px;
  height: 10px;
  border-left: 2px solid #1A1A2E;
  border-bottom: 2px solid #1A1A2E;
  transform: rotate(45deg);
  margin-left: 3px;
}

.nav-title {
  font-size: 17px;
  font-weight: 600;
  color: #1A1A2E;
}

.nav-placeholder-right {
  width: 36px;
}

/* ===== 内容滚动区 ===== */
.content-scroll {
  flex: 1;
  width: 100%;
}

.content-body {
  padding: 20px 16px;
  background: #fff;
  margin: 12px 0 0;
  border-radius: 0;
}

/* ===== 富文本样式 ===== */
.content-body .doc-title {
  display: block;
  font-size: 20px;
  font-weight: 700;
  color: #1A1A2E;
  text-align: center;
  margin-bottom: 8px;
}

.content-body .doc-version {
  display: block;
  font-size: 12px;
  color: #9BA3B2;
  text-align: center;
  margin-bottom: 24px;
}

.content-body .doc-section {
  margin-bottom: 20px;
}

.content-body .section-title {
  display: block;
  font-size: 16px;
  font-weight: 600;
  color: #1A1A2E;
  margin-bottom: 8px;
  padding-left: 10px;
  border-left: 3px solid #1677FF;
}

.content-body .section-content {
  display: block;
  font-size: 14px;
  color: #5A6B7D;
  line-height: 1.8;
  margin-bottom: 6px;
  text-align: justify;
}

.content-body .section-list {
  display: block;
  font-size: 14px;
  color: #5A6B7D;
  line-height: 1.8;
  padding-left: 16px;
  margin-bottom: 4px;
}

/* ===== 底部 ===== */
.content-footer {
  padding: 24px 16px 40px;
  text-align: center;
}

.footer-text {
  font-size: 12px;
  color: #C8CDD6;
}
