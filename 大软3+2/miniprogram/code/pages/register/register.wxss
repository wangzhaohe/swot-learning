/* pages/register/register.wxss */


.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  background-color: #b3d4db;
}

.title {
  color: #666;
  margin-top: 100rpx;
  font-size: 32rpx;
  font-weight: bold;
}

.btn-container {
  width: 200rpx;
  height: 80rpx;
  text-align: center;
  border-radius: 10rpx;
  border: 1rpx solid #666;
  margin-top: 200rpx;
}

.text-container {
  line-height: 80rpx;
}

.image {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
}