<!--pages/my/my.wxml-->
<view class="my-page">
  <!-- 用户信息卡片 -->
  <view class="user-card">
    <image class="user-avatar" src="{{userInfo.avatarUrl}}" mode="cover"></image>
    <view class="user-info">
      <text class="user-name" wx:if="{{hasUserInfo}}">{{userInfo.nickName}}</text>
      <text class="user-name" wx:else>未登录</text>
    </view>
    <view class="edit-btn" bindtap="goToProfile">
      <text>编辑资料</text>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu-list">
    <view class="menu-item" bindtap="goToHelp">
      <text class="menu-icon">❓</text>
      <text class="menu-text">帮助中心</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 退出登录 -->
  <view class="logout-section" wx:if="{{hasUserInfo}}">
    <button class="logout-btn" bindtap="logout">退出登录</button>
  </view>
</view>
