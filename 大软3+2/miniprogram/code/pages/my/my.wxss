/* pages/my/my.wxss */
.my-page {
  min-height: 100vh;
  background-color: #f5f5f5;
}

.user-card {
  display: flex;
  align-items: center;
  padding: 40rpx 30rpx;
  background: linear-gradient(135deg, #b3d4db 0%, #89c4cc 100%);
  margin-bottom: 20rpx;
}

.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.8);
  background-color: #eee;
}

.user-info {
  flex: 1;
  margin-left: 24rpx;
}

.user-name {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
}

.edit-btn {
  padding: 12rpx 24rpx;
  border: 2rpx solid rgba(255, 255, 255, 0.8);
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #fff;
}

/* 功能菜单 */
.menu-list {
  background-color: #fff;
  margin: 0 20rpx 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.menu-text {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

.menu-arrow {
  font-size: 36rpx;
  color: #ccc;
}

/* 退出登录 */
.logout-section {
  padding: 60rpx 30rpx;
}

.logout-btn {
  width: 100%;
  background-color: #fff;
  color: #e74c3c;
  font-size: 30rpx;
  border-radius: 16rpx;
  border: 2rpx solid #e74c3c;
}
