/* pages/login/login.wxss */

page {
  width: 100%;
  height: 100%;
  background: #fff;
  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', sans-serif;
  overflow: hidden;
}

.page {
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  position: relative;
}

/* ===== 背景装饰 ===== */
.bg-deco {
  position: absolute;
  pointer-events: none;
  z-index: 0;
}
.bg-deco-tl {
  top: 0;
  right: 0;
  width: 180px;
  height: 180px;
  background: radial-gradient(circle at 140px 40px, rgba(22,119,255,0.06) 0%, transparent 70%);
}
.bg-deco-br {
  bottom: 80px;
  left: -30px;
  width: 160px;
  height: 160px;
  background: radial-gradient(circle at 20px 140px, rgba(10,197,255,0.05) 0%, transparent 70%);
}

/* ===== 导航栏占位 ===== */
.nav-placeholder {
  flex-shrink: 0;
}

/* ===== 返回按钮（绝对定位） ===== */
.back-btn {
  position: absolute;
  left: 0;
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  z-index: 10;
}
.back-btn-hover {
  background: #F5F5F5;
}
.back-arrow {
  width: 20px;
  height: 20px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.icon-arrow-left {
  width: 10px;
  height: 10px;
  border-left: 2px solid #1A1A2E;
  border-bottom: 2px solid #1A1A2E;
  transform: rotate(45deg);
  margin-left: 3px;
}

/* ===== 主体滚动区 ===== */
.body-scroll {
  flex: 1;
  width: 100%;
  padding: 0 16px 40px;
  position: relative;
  z-index: 1;
  box-sizing: border-box;
}

/* ===== Logo 区域 ===== */
.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20px 0 36px;
}
.logo-icon {
  width: 72px;
  height: 72px;
  border-radius: 20px;
  background: linear-gradient(135deg, #1677FF 0%, #0AC5FF 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 14px;
  box-shadow: 0 8px 24px rgba(22,119,255,0.28);
}
.logo-name {
  font-size: 22px;
  font-weight: 700;
  color: #1A1A2E;
  letter-spacing: 2px;
}
.logo-slogan {
  font-size: 12px;
  color: #9BA3B2;
  margin-top: 5px;
  letter-spacing: 0.5px;
}

/* ===== 3D打印机 Logo 图形 ===== */
.logo-printer {
  width: 40px;
  height: 40px;
  position: relative;
}
.printer-body {
  position: absolute;
  bottom: 0;
  left: 4px;
  width: 32px;
  height: 14px;
  border: 1.5px solid rgba(255,255,255,0.85);
  border-radius: 3px;
  background: rgba(255,255,255,0.15);
}
.printer-head {
  position: absolute;
  top: 3px;
  left: 10px;
  width: 20px;
  height: 14px;
  border: 1.5px solid rgba(255,255,255,0.85);
  border-radius: 2px;
  background: rgba(255,255,255,0.12);
}
.printer-nozzle {
  position: absolute;
  top: 16px;
  left: 16px;
  width: 2px;
  height: 6px;
  background: rgba(255,255,255,0.85);
  border-radius: 1px;
  box-shadow: 6px 0 0 0 rgba(255,255,255,0.85);
}
.printer-rail {
  position: absolute;
  top: 0;
  left: -2px;
  width: 44px;
  height: 2px;
  background: rgba(255,255,255,0.85);
  border-radius: 1px;
}
.printer-object {
  position: absolute;
  bottom: 0;
  left: 12px;
  width: 16px;
  height: 6px;
  background: rgba(255,255,255,0.6);
  border-radius: 1px;
}

/* ===== 功能亮点区域 ===== */
.features-section {
  display: flex;
  justify-content: center;
  gap: 24px;
  padding: 28px 0 20px;
}
.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8px;
  min-width: 70px;
}
.feature-icon {
  width: 44px;
  height: 44px;
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}
.feature-icon-security {
  background: linear-gradient(135deg, rgba(22,119,255,0.1) 0%, rgba(10,197,255,0.08) 100%);
}
.feature-icon-security::before {
  content: '';
  position: absolute;
  width: 18px;
  height: 22px;
  border: 2px solid #1677FF;
  border-radius: 3px 3px 8px 8px;
  top: 10px;
}
.feature-icon-security::after {
  content: '';
  position: absolute;
  width: 6px;
  height: 4px;
  background: #1677FF;
  border-radius: 0 0 3px 3px;
  bottom: 12px;
}
.feature-icon-speed {
  background: linear-gradient(135deg, rgba(22,119,255,0.1) 0%, rgba(10,197,255,0.08) 100%);
}
.feature-icon-speed::before {
  content: '';
  position: absolute;
  width: 20px;
  height: 20px;
  border: 2.5px solid #0AC5FF;
  border-radius: 50%;
  border-top-color: transparent;
  top: 11px;
}
.feature-icon-auth {
  background: linear-gradient(135deg, rgba(22,119,255,0.1) 0%, rgba(10,197,255,0.08) 100%);
}
.feature-icon-auth::before {
  content: '';
  position: absolute;
  width: 18px;
  height: 14px;
  border: 2px solid #1677FF;
  border-radius: 4px;
  top: 13px;
}
.feature-icon-auth::after {
  content: '';
  position: absolute;
  width: 5px;
  height: 9px;
  border: solid #1677FF;
  border-width: 0 2px 2px 0;
  transform: rotate(45deg);
  left: 17px;
  top: 16px;
}
.feature-text {
  font-size: 12px;
  color: #5A6B7D;
  font-weight: 500;
}

/* ===== 表单区域 ===== */
.form-section {
  display: flex;
  flex-direction: column;
  gap: 14px;
}

/* ===== 协议行 ===== */
.agree-row {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 14px;
}
.custom-checkbox {
  width: 18px;
  height: 18px;
  border-radius: 5px;
  border: 1.5px solid #1677FF;
  background: #1677FF;
  flex-shrink: 0;
  position: relative;
}
.custom-checkbox.unchecked {
  background: #fff;
  border-color: #C8CDD6;
}
.custom-checkbox::after {
  content: '';
  position: absolute;
  top: 2px;
  left: 5px;
  width: 5px;
  height: 9px;
  border: solid #fff;
  border-width: 0 2px 2px 0;
  transform: rotate(45deg);
  display: none;
}
.custom-checkbox:not(.unchecked)::after {
  display: block;
}
.agree-text {
  font-size: 12px;
  color: #9BA3B2;
  line-height: 1.6;
}
.agree-link {
  color: #1677FF;
}

/* ===== 微信登录主按钮 ===== */
.wechat-btn-primary {
  width: 100%;
  height: 52px;
  background: linear-gradient(90deg, #1677FF 0%, #0AC5FF 100%);
  border: none;
  border-radius: 14px;
  color: #fff;
  font-size: 16px;
  font-weight: 600;
  letter-spacing: 1px;
  box-shadow: 0 6px 20px rgba(22,119,255,0.32);
  line-height: 52px;
  margin-top: 6px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
}
.wechat-btn-primary::after {
  border: none;
}
.wechat-btn-primary:active {
  opacity: 0.9;
  box-shadow: 0 4px 14px rgba(22,119,255,0.3);
}

/* ===== 微信图标 ===== */
.wechat-icon {
  position: relative;
  width: 22px;
  height: 22px;
  flex-shrink: 0;
}
.wc-bubble {
  position: absolute;
  border: 1.5px solid #fff;
  border-radius: 50%;
}
.wc-bubble1 {
  width: 16px;
  height: 14px;
  left: 0;
  top: 3px;
  background: rgba(255,255,255,0.2);
}
.wc-bubble2 {
  width: 13px;
  height: 11px;
  right: 0;
  bottom: 0;
  background: rgba(255,255,255,0.15);
}
.wc-eye {
  position: absolute;
  background: #fff;
  border-radius: 50%;
}
.wc-eye1 {
  width: 2.5px;
  height: 2.5px;
  top: 4px;
  left: 4px;
}
.wc-eye2 {
  width: 2.5px;
  height: 2.5px;
  top: 4px;
  right: 4px;
}
.wc-eye3 {
  width: 2px;
  height: 2px;
  top: 3.5px;
  left: 3px;
}
.wc-eye4 {
  width: 2px;
  height: 2px;
  top: 3.5px;
  right: 3px;
}

/* ===== 底部链接 ===== */
.footer-links {
  display: flex;
  justify-content: center;
  gap: 24px;
  margin-top: 32px;
  padding-bottom: 20px;
}
.footer-link {
  font-size: 12px;
  color: #BEC5D0;
}
