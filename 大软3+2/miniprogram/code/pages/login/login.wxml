<view class="page">
  <view class="bg-deco bg-deco-tl"></view>
  <view class="bg-deco bg-deco-br"></view>
  <view class="nav-placeholder" style="height:{{navPlaceholderHeight}}px"></view>
  <view class="back-btn" style="top:{{backBtnTop}}px" bindtap="goBack" hover-class="back-btn-hover">
    <view class="back-arrow">
      <view class="icon-arrow-left"></view>
    </view>
  </view>
  <scroll-view class="body-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="logo-section">
      <view class="logo-icon">
        <view class="logo-printer">
          <view class="printer-body"></view>
          <view class="printer-head"></view>
          <view class="printer-nozzle"></view>
          <view class="printer-rail"></view>
          <view class="printer-object"></view>
        </view>
      </view>
      <text class="logo-name">司维者</text>
      <text class="logo-slogan">3D打印 · 沙盘模型 · 数字孪生</text>
    </view>
    <!-- 功能亮点区域 -->
    <view class="features-section">
      <view class="feature-item">
        <view class="feature-icon feature-icon-security"></view>
        <text class="feature-text">安全可靠</text>
      </view>
      <view class="feature-item">
        <view class="feature-icon feature-icon-speed"></view>
        <text class="feature-text">快速便捷</text>
      </view>
      <view class="feature-item">
        <view class="feature-icon feature-icon-auth"></view>
        <text class="feature-text">一键授权</text>
      </view>
    </view>
    <view class="form-section">
      <view class="agree-row">
        <view class="custom-checkbox {{!agreed ? 'unchecked' : ''}}" bindtap="toggleAgree"></view>
        <view class="agree-text-wrap">
          <text class="agree-text">我已阅读并同意</text>
          <text class="agree-link" bindtap="showAgreement">《用户协议》</text>
          <text class="agree-text">及</text>
          <text class="agree-link" bindtap="showPrivacy">《隐私政策》</text>
        </view>
      </view>
      <button class="wechat-btn-primary" bindtap="wechatLogin">
        <view class="wechat-icon">
          <view class="wc-bubble wc-bubble1">
            <view class="wc-eye wc-eye1"></view>
            <view class="wc-eye wc-eye2"></view>
          </view>
          <view class="wc-bubble wc-bubble2">
            <view class="wc-eye wc-eye3"></view>
            <view class="wc-eye wc-eye4"></view>
          </view>
        </view>
        <text>微信授权登录</text>
      </button>
    </view>
    <view class="footer-links">
      <text class="footer-link" bindtap="showHelp">遇到问题？</text>
      <text class="footer-link" bindtap="showPrivacy">隐私政策</text>
    </view>
  </scroll-view>
</view>