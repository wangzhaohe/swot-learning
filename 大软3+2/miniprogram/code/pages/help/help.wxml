<!-- pages/help/help.wxml -->
<view class="page">
  <nav-bar title="帮助中心" show-back bind:back="goBack"></nav-bar>

  <scroll-view class="content-scroll" scroll-y enhanced show-scrollbar="{{false}}">
    <view class="content-body">
      <view class="help-section">
        <view class="section-title">常见问题</view>
        
        <view class="faq-item" bindtap="toggleFaq" data-index="0">
          <view class="faq-header">
            <text class="faq-question">如何上传3D模型文件？</text>
            <view class="faq-arrow {{openFaq[0] ? 'open' : ''}}"></view>
          </view>
          <view class="faq-answer {{openFaq[0] ? 'show' : ''}}">
            <text class="answer-text">您可以在"下单"页面点击"上传模型"按钮，选择您的3D模型文件（支持STL、OBJ、3MF格式）。文件大小不超过100MB。</text>
          </view>
        </view>

        <view class="faq-item" bindtap="toggleFaq" data-index="1">
          <view class="faq-header">
            <text class="faq-question">打印价格如何计算？</text>
            <view class="faq-arrow {{openFaq[1] ? 'open' : ''}}"></view>
          </view>
          <view class="faq-answer {{openFaq[1] ? 'show' : ''}}">
            <text class="answer-text">打印价格根据模型的体积、材料、精度要求等因素综合计算。您上传模型后，系统会自动计算价格，您也可以在下单前查看预估价格。</text>
          </view>
        </view>

        <view class="faq-item" bindtap="toggleFaq" data-index="2">
          <view class="faq-header">
            <text class="faq-question">订单多久可以发货？</text>
            <view class="faq-arrow {{openFaq[2] ? 'open' : ''}}"></view>
          </view>
          <view class="faq-answer {{openFaq[2] ? 'show' : ''}}">
            <text class="answer-text">一般情况下，订单确认后1-3个工作日内发货。具体时间取决于模型复杂度和当前订单量。您可以在"我的订单"中查看订单状态。</text>
          </view>
        </view>

        <view class="faq-item" bindtap="toggleFaq" data-index="3">
          <view class="faq-header">
            <text class="faq-question">如何修改或取消订单？</text>
            <view class="faq-arrow {{openFaq[3] ? 'open' : ''}}"></view>
          </view>
          <view class="faq-answer {{openFaq[3] ? 'show' : ''}}">
            <text class="answer-text">订单在"待支付"和"待确认"状态下可以取消。已开始打印的订单无法取消或修改。如有特殊情况，请联系客服处理。</text>
          </view>
        </view>

        <view class="faq-item" bindtap="toggleFaq" data-index="4">
          <view class="faq-header">
            <text class="faq-question">打印失败怎么办？</text>
            <view class="faq-arrow {{openFaq[4] ? 'open' : ''}}"></view>
          </view>
          <view class="faq-answer {{openFaq[4] ? 'show' : ''}}">
            <text class="answer-text">如果因我方原因导致打印失败，我们将免费重新打印。如果因模型文件问题导致失败，我们的技术团队会联系您协助修改文件。</text>
          </view>
        </view>
      </view>

      <view class="help-section">
        <view class="section-title">联系我们</view>
        <view class="contact-list">
          <view class="contact-item">
            <view class="contact-icon phone-icon"></view>
            <view class="contact-info">
              <text class="contact-label">客服电话</text>
              <text class="contact-value" bindtap="makePhoneCall">400-XXX-XXXX</text>
            </view>
          </view>

          <view class="contact-item">
            <view class="contact-icon email-icon"></view>
            <view class="contact-info">
              <text class="contact-label">客服邮箱</text>
              <text class="contact-value">service@siweizhe.com</text>
            </view>
          </view>

          <view class="contact-item">
            <view class="contact-icon time-icon"></view>
            <view class="contact-info">
              <text class="contact-label">服务时间</text>
              <text class="contact-value">工作日 9:00-18:00</text>
            </view>
          </view>
        </view>
      </view>

      <view class="help-section">
        <view class="section-title">意见反馈</view>
        <view class="feedback-tip">
          <text class="tip-text">如果您有任何建议或意见，欢迎通过以下方式反馈：</text>
        </view>
        <view class="feedback-btn" bindtap="openFeedback">
          <text class="btn-text">提交反馈</text>
        </view>
      </view>
    </view>
  </scroll-view>
</view>
