/* pages/help/help.wxss */

page {
  width: 100%;
  height: 100%;
  background: #F5F7FA;
  font-family: -apple-system, 'PingFang SC', 'Helvetica Neue', sans-serif;
}

.page {
  width: 100%;
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #F5F7FA;
}

/* ===== 导航栏 ===== */
.nav-bar {
  width: 100%;
  height: 44px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 16px;
  background: #fff;
  border-bottom: 0.5px solid #E8ECF0;
  flex-shrink: 0;
  padding-top: env(safe-area-inset-top);
}

.nav-back {
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.nav-back-hover {
  background: #F5F5F5;
}

.nav-arrow {
  width: 10px;
  height: 10px;
  border-left: 2px solid #1A1A2E;
  border-bottom: 2px solid #1A1A2E;
  transform: rotate(45deg);
  margin-left: 3px;
}

.nav-title {
  font-size: 17px;
  font-weight: 600;
  color: #1A1A2E;
}

.nav-placeholder-right {
  width: 36px;
}

/* ===== 内容滚动区 ===== */
.content-scroll {
  flex: 1;
  width: 100%;
}

.content-body {
  padding: 12px 0 40px;
}

/* ===== 区块 ===== */
.help-section {
  background: #fff;
  margin-bottom: 12px;
  padding: 16px;
}

.section-title {
  font-size: 16px;
  font-weight: 600;
  color: #1A1A2E;
  margin-bottom: 12px;
  padding-left: 10px;
  border-left: 3px solid #1677FF;
}

/* ===== 常见问题 ===== */
.faq-item {
  border-bottom: 0.5px solid #F0F2F5;
  padding: 12px 0;
}

.faq-item:last-child {
  border-bottom: none;
}

.faq-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.faq-question {
  font-size: 14px;
  color: #1A1A2E;
  font-weight: 500;
  flex: 1;
}

.faq-arrow {
  width: 8px;
  height: 8px;
  border-right: 2px solid #9BA3B2;
  border-bottom: 2px solid #9BA3B2;
  transform: rotate(45deg);
  transition: transform 0.3s ease;
  flex-shrink: 0;
  margin-left: 8px;
}

.faq-arrow.open {
  transform: rotate(-135deg);
}

.faq-answer {
  max-height: 0;
  overflow: hidden;
  transition: max-height 0.3s ease, padding 0.3s ease;
  padding: 0 0 0 0;
}

.faq-answer.show {
  max-height: 200px;
  padding: 8px 0 0 0;
}

.answer-text {
  font-size: 13px;
  color: #5A6B7D;
  line-height: 1.8;
  display: block;
  padding: 8px 12px;
  background: #F8F9FA;
  border-radius: 8px;
}

/* ===== 联系我们 ===== */
.contact-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.contact-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px;
  background: #F8F9FA;
  border-radius: 10px;
}

.contact-icon {
  width: 36px;
  height: 36px;
  border-radius: 10px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.phone-icon {
  background: linear-gradient(135deg, #1677FF 0%, #0AC5FF 100%);
}

.phone-icon::before {
  content: '';
  width: 16px;
  height: 16px;
  border: 2px solid #fff;
  border-radius: 50%;
  position: relative;
}

.phone-icon::after {
  content: '';
  position: absolute;
  width: 6px;
  height: 10px;
  border: 2px solid #fff;
  border-radius: 2px;
  margin-top: 3px;
}

.email-icon {
  background: linear-gradient(135deg, #1677FF 0%, #0AC5FF 100%);
}

.email-icon::before {
  content: '';
  width: 14px;
  height: 10px;
  border: 2px solid #fff;
  border-radius: 2px;
}

.time-icon {
  background: linear-gradient(135deg, #1677FF 0%, #0AC5FF 100%);
}

.time-icon::before {
  content: '';
  width: 14px;
  height: 14px;
  border: 2px solid #fff;
  border-radius: 50%;
}

.contact-info {
  display: flex;
  flex-direction: column;
  gap: 2px;
}

.contact-label {
  font-size: 12px;
  color: #9BA3B2;
}

.contact-value {
  font-size: 14px;
  color: #1A1A2E;
  font-weight: 500;
}

/* ===== 意见反馈 ===== */
.feedback-tip {
  margin-bottom: 12px;
}

.tip-text {
  font-size: 14px;
  color: #5A6B7D;
  line-height: 1.6;
}

.feedback-btn {
  width: 100%;
  height: 44px;
  background: linear-gradient(90deg, #1677FF 0%, #0AC5FF 100%);
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.feedback-btn:active {
  opacity: 0.9;
}

.btn-text {
  font-size: 15px;
  font-weight: 600;
  color: #fff;
}
