/* components/nav-bar/nav-bar.wxss */

.nav-wrap {
  width: 100%;
  background: #fff;
  border-bottom: 0.5px solid #E8ECF0;
  flex-shrink: 0;
}

.nav-bar {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 16px 0 0;
  box-sizing: border-box;
}

.nav-back {
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
}

.nav-back-hover {
  background: #F5F5F5;
}

.nav-arrow {
  width: 10px;
  height: 10px;
  border-left: 2px solid #1A1A2E;
  border-bottom: 2px solid #1A1A2E;
  transform: rotate(45deg);
  margin-left: 3px;
}

.nav-title {
  font-size: 17px;
  font-weight: 600;
  color: #1A1A2E;
}

.nav-right {
  width: 36px;
  flex-shrink: 0;
}
