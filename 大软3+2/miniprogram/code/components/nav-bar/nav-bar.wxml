<!-- components/nav-bar/nav-bar.wxml -->
<view class="nav-wrap" style="padding-top: {{statusBarHeight}}px;">
  <view class="nav-bar" style="height: {{navHeight}}px;">
    <view class="nav-back" wx:if="{{showBack}}" bindtap="onBack" hover-class="nav-back-hover">
      <view class="nav-arrow"></view>
    </view>
    <text class="nav-title">{{title}}</text>
    <view class="nav-right"></view>
  </view>
</view>
